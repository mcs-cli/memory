{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/memory-loop\" hook",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/memory-loop\" hook --index",
            "timeout": 240,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/memory-loop\" hook",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/memory-loop\" hook --index",
            "timeout": 240,
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/memory-loop\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/memory-loop\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|.*spawn_agent|mcp__.*memory[-_]brief__prepare_brief",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/memory-loop\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*memory[-_]loop__query",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/memory-loop\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
